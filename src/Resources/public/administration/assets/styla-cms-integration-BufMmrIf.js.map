{% block styla_cmsintegration_content_card_channel_config_accounts_card %}
    <sw-card class="sw-card--grid"
             :title="$tc('styla-cms-integration-plugin.configuration.group.general.title')">

        {% block styla_cmsintegration_content_card_channel_config_accounts_card_container %}
            <sw-container>

                {% block styla_cmsintegration_content_card_channel_config_accounts_card_container_settings %}
                    <div v-if="actualConfigData" class="card-container">

                        {% block styla_cmsintegration_content_card_channel_config_pages %}
                            <sw-inherit-wrapper
                                v-model:value="actualConfigData['StylaCmsIntegration.settings.extraPagesAllowedToOverride']"
                                :inherited-value="selectedSalesChannelId === null ? null : allConfigs['null']['StylaCmsIntegration.settings.extraPagesAllowedToOverride']"
                                :customInheritationCheckFunction="checkTextFieldInheritance"
                            >
                                <template #content="{ currentValue, updateCurrentValue, isInherited }">
                                    <mt-textarea
                                        name="StylaCmsIntegration.settings.extraPagesAllowedToOverride"
                                        :map-inheritance="props"
                                        :label="$tc('styla-cms-integration-plugin.configuration.field.extraPages.label')"
                                        :helpText="$tc('styla-cms-integration-plugin.configuration.field.extraPages.helpText')"
                                        :disabled="isInherited"
                                        :model-value="currentValue"
                                        @update:model-value="updateCurrentValue"
                                    />
                                </template>
                            </sw-inherit-wrapper>
                        {% endblock %}
                        {% block styla_cmsintegration_content_card_channel_config_interval %}
                            <sw-inherit-wrapper
                                v-model:value="actualConfigData['StylaCmsIntegration.settings.pagesListSynchronizationInterval']"
                                :inherited-value="selectedSalesChannelId === null ? null : allConfigs['null']['StylaCmsIntegration.settings.pagesListSynchronizationInterval']">
                                <template #content="{ currentValue, updateCurrentValue, isInherited }">
                                    <mt-number-field
                                        name="StylaCmsIntegration.settings.pagesListSynchronizationInterval"
                                        number-type="int"
                                        :min="1"
                                        :map-inheritance="props"
                                        :label="$tc('styla-cms-integration-plugin.configuration.field.syncInterval.label')"
                                        :helpText="$tc('styla-cms-integration-plugin.configuration.field.syncInterval.helpText')"
                                        :disabled="isInherited"
                                        :model-value="currentValue"
                                        :size="small"
                                        :placeholder=""
                                        @update:model-value="updateCurrentValue"
                                    />
                                </template>
                            </sw-inherit-wrapper>
                        {% endblock %}
                        {% block styla_cmsintegration_content_card_channel_config_cache_lifetime %}
                            <sw-inherit-wrapper
                                v-model:value="actualConfigData['StylaCmsIntegration.settings.pageCacheDuration']"
                                :inherited-value="selectedSalesChannelId === null ? null : allConfigs['null']['StylaCmsIntegration.settings.pageCacheDuration']">
                                <template #content="{ currentValue, updateCurrentValue, isInherited }">
                                    <mt-number-field
                                        name="StylaCmsIntegration.settings.pageCacheDuration"
                                        number-type="int"
                                        :min="1"
                                        :map-inheritance="props"
                                        :label="$tc('styla-cms-integration-plugin.configuration.field.pageCache.label')"
                                        :helpText="$tc('styla-cms-integration-plugin.configuration.field.pageCache.helpText')"
                                        :disabled="isInherited"
                                        :model-value="currentValue"
                                        :size="small"
                                        :placeholder=""
                                        @update:model-value="updateCurrentValue"
                                    />
                                </template>
                            </sw-inherit-wrapper>
                        {% endblock %}
                        {% block styla_cmsintegration_content_card_channel_config_use_full_path %}
                            <sw-inherit-wrapper
                                v-model:value="actualConfigData['StylaCmsIntegration.settings.useFullPath']"
                                :inherited-value="selectedSalesChannelId === null ? null : allConfigs['null']['StylaCmsIntegration.settings.useFullPath']">
                                <template #content="{ currentValue, updateCurrentValue, isInherited }">
                                    <sw-single-select
                                        :label="$tc('styla-cms-integration-plugin.configuration.field.useFullPath.label')"
                                        :helpText="$tc('styla-cms-integration-plugin.configuration.field.useFullPath.helpText')"
                                        :disabled="isInherited"
                                        :options="useFullPathOptions"
                                        :value="currentValue"
                                        :disableSearchFunction="true"
                                        @update:value="updateCurrentValue"
                                    />
                                </template>
                            </sw-inherit-wrapper>
                        {% endblock %}

                    </div>
                {% endblock %}
            </sw-container>
        {% endblock %}

    </sw-card>
{% endblock %}
