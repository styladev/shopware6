{
    "version": "1.3.9",
    "name": "styla/cms-integration",
    "description": "Plugin for integration between Styla CMS and Shopware 6 (v6.6)",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Styla\\CmsIntegration\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Styla\\CmsIntegration\\StylaCmsIntegration",
        "plugin-icon": "src/Resources/config/plugin.png",
        "label": {
            "de-DE": "Styla CMS Integrations-Plugin (für Shopware 6.6)",
            "en-GB": "Styla CMS integration plugin (for Shopware 6.6)"
        }
    },
    "require": {
        "php": "^8.2",
        "shopware/administration": "v6.6.*",
        "shopware/core": "v6.6.*",
        "shopware/storefront": "v6.6.*"
    }
}
